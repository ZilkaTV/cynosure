{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cynosure",
  "compatibility_date": "2026-08-15",
  // @supabase/supabase-js and @anthropic-ai/sdk (used by worker/help-chat.js)
  // have historically needed Node built-in shims (node:crypto, node:stream,
  // etc.) that only Workers' Node compat layer provides.
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  // Without this, every `wrangler deploy` (run by the dashboard's
  // git-connected build on each push) wipes out whatever secrets were set
  // via `wrangler secret put` (see README/setup notes) - this file has no
  // `vars` section of its own for the two real secrets
  // (SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, which must never end up
  // in git), so without keep_vars Wrangler would treat this config as the
  // whole truth and clear them on every push.
  "keep_vars": true,
  // Not secret - already public/anon-scoped (same values baked into the
  // client bundle via import.meta.env.VITE_*, see .env.local) - committed
  // directly rather than left to a dashboard form, after the dashboard's
  // "Variables and Secrets" UI repeatedly failed to actually reach the
  // deployed Worker's env at runtime (env.<key> came back undefined and
  // Object.keys(env) came back empty, confirmed directly via a temporary
  // diagnostic response, even with keep_vars set and after multiple
  // redeploys) - root cause never fully identified, but a committed `vars`
  // entry is unambiguously reliable where the dashboard form was not.
  "vars": {
    "VITE_SUPABASE_URL": "https://mynrwxjtqmcyubeyryge.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im15bnJ3eGp0cW1jeXViZXlyeWdlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM4NDk1MzUsImV4cCI6MjA5OTQyNTUzNX0.O2HrmGSN_XnNF2AsWUv7tA5JPIiLV2dQQ24Zxg1V-a8"
  },
  "assets": {
    // Vite's build output (npm run build) - this is the "Build-Befehl" the
    // Cloudflare dashboard runs before `wrangler deploy` picks this file up.
    "directory": "./dist/",
    // SPA fallback: any path that isn't a static file and isn't matched by
    // run_worker_first below gets index.html, so React Router can handle it
    // client-side (replaces public/_redirects' old Pages-specific role for
    // routing purposes - _headers still applies to static asset responses,
    // see public/_headers).
    "not_found_handling": "single-page-application",
    // Every /api/* request is routed to the Worker (worker/index.js)
    // instead of being looked up as a static file - everything else never
    // invokes the Worker at all.
    "run_worker_first": ["/api/*"]
  }
}
